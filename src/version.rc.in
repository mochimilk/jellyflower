#include <winver.h>
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "mochimilk\0"
   VALUE "FileDescription", "jellyflower\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductName", "jellyflower\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "LegalCopyright", "GPL-3.0-or-later; see accompanying source and notices\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
